{
  "appId": "com.ybex.app",
  "appName": "Ybex",
  "webDir": "../dist/client",
  "backgroundColor": "#7E00DC",
  "android": {
    "backgroundColor": "#7E00DC",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "allowNavigation": [
      "ybexapp.ai.studio",
      "ybexmedia.in",
      "*.ybexmedia.in",
      "checkout.razorpay.com",
      "api.razorpay.com",
      "*.razorpay.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#7E00DC",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#7E00DC"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "updateUrl": "https://ybexapp.ai.studio/api/app/android-update",
      "statsUrl": "",
      "channelUrl": "",
      "directUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 10000,
      "version": "builtin",
      "allowModifyUrl": true,
      "persistModifyUrl": true
    }
  }
}
